# Swift Package Manager
.build/
.swiftpm/
# Package.resolved is COMMITTED (executable app) — pins exact dependency versions so
# CI builds what you build locally. An uncommitted lockfile let swift-sdk float from
# 0.10.x to 0.12.x and broke CI; the lockfile + .upToNextMinor pin prevent that.

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xccheckout
*.xcscmblueprint
DerivedData/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE
.idea/
*.swp
*.swo
*~

# Test output
*.xcresult

# Build artifacts
*.o
*.a
*.dylib

# Claude Code session logs (private workspace)
sessions/

# Specs are TRACKED on the private origin (apple-bridge.Dev); kept out of the public
# repo's release archive via .gitattributes `specs/ export-ignore` — not gitignored.
.claude/
